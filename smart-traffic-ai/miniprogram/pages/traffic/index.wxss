.time-row { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 12rpx; }
.time-big { font-size: 64rpx; font-weight: 700; }
.ticks { display: flex; justify-content: space-between; padding: 0 8rpx; margin-bottom: 20rpx; }
.weather-row { display: flex; gap: 16rpx; margin-top: 8rpx; }
.w-btn {
  padding: 10rpx 28rpx; border: 1rpx solid #d8cbb2; font-size: 24rpx; color: #5c6a78;
}
.w-btn.on { background: #232f3b; color: #f4eee2; border-color: #232f3b; }

.corridor { padding: 18rpx 0; border-bottom: 1rpx dashed #d8cbb2; }
.corridor-name { font-size: 27rpx; font-weight: 600; margin-bottom: 10rpx; }
.corridor-bar { height: 12rpx; background: #ece2cf; margin-bottom: 8rpx; }
.bar-fill { height: 100%; }
.bar-fill.lv1 { background: #2e9e6b; } .bar-fill.lv2 { background: #e8a13c; }
.bar-fill.lv3 { background: #e2593b; } .bar-fill.lv4 { background: #b32d2d; }
.corridor-meta { display: flex; justify-content: space-between; font-size: 23rpx; }
